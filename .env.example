POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8080

HTTP_PORT=80
HTTPS_PORT=443

# Public address (no trailing slash). Production example:
# PUBLIC_HOST=proxy.bibliolatino.com
# APP_URL=https://proxy.bibliolatino.com
# KEYCLOAK_PUBLIC_URL=https://proxy.bibliolatino.com
PUBLIC_HOST=localhost
PUBLIC_SCHEME=http
APP_URL=http://localhost
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_SSL_REQUIRED=none

OAUTH2_PROXY_CLIENT_SECRET=library-proxy-secret-change-me
# Exactly 16, 24, or 32 raw bytes (e.g. openssl rand -hex 16)
OAUTH2_PROXY_COOKIE_SECRET=15251ad9b910ec583bd425e34ed2bd04
OAUTH2_PROXY_COOKIE_SECURE=false

# Comma-separated campus CIDRs for IP auth bypass (Milestone 2)
# INSTITUTIONAL_CIDRS=10.0.0.0/8,192.168.0.0/16
INSTITUTIONAL_CIDRS=

GUEST_CLIENT_SECRET=guest-portal-secret-change-me

# Milestone 4 — OpenLDAP (usuarios.bibliolatino.com)
# Prefer service-account bind (uid=keycloak,ou=services,...)
LDAP_URL=ldap://169.58.217.129:389
LDAP_BASE_DN=dc=usuarios,dc=bibliolatino,dc=com
LDAP_USERS_OU=ou=usuarios,dc=usuarios,dc=bibliolatino,dc=com
LDAP_KC_BIND_DN=uid=keycloak,ou=services,dc=usuarios,dc=bibliolatino,dc=com
LDAP_KC_BIND_PASSWORD=change-me
LDAP_BIND_DN=cn=admin,dc=usuarios,dc=bibliolatino,dc=com
LDAP_BIND_PASSWORD=change-me

CERTBOT_EMAIL=admin@example.com
