{
  "realm": "library",
  "enabled": true,
  "displayName": "University Library",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard library user"
      },
      {
        "name": "admin",
        "description": "Library administrator"
      },
      {
        "name": "guest",
        "description": "Approved guest / alumni"
      }
    ]
  },
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@library.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demo123",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "librarian",
      "enabled": true,
      "email": "librarian@library.local",
      "emailVerified": true,
      "firstName": "Library",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "admin"]
    }
  ],
  "clients": [
    {
      "clientId": "library-proxy",
      "name": "Nginx / oauth2-proxy",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "library-proxy-secret-change-me",
      "redirectUris": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost/oauth2/callback",
        "http://127.0.0.1/oauth2/callback",
        "https://localhost/*",
        "https://localhost/oauth2/callback"
      ],
      "webOrigins": [
        "http://localhost",
        "http://127.0.0.1",
        "https://localhost",
        "+"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "guest-portal",
      "name": "Guest self-registration portal (Milestone 3)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "guest-portal-secret-change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';"
  }
}
